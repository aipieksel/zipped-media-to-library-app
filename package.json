{
  "name": "folio-html-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-capture.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-capture.mjs && tsc -b && vite build && node scripts/build-worker.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "prebuild": "npm run check:privacy",
    "pretest": "npm run check:privacy && node --test tests/repository-privacy.test.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "jszip": "3.10.1",
    "idb": "8.0.3",
    "html-to-image": "1.11.13",
    "es-module-lexer": "1.7.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.15.30",
    "@vitejs/plugin-react": "4.5.2",
    "esbuild": "0.25.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
